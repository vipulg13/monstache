FROM golang:latest as build
RUN apk add --no-cache gcc musl-dev

RUN mkdir /app
WORKDIR /app
COPY . .
RUN go mod download

RUN mkdir -p build/linux-amd64

RUN env GOOS=linux GOARCH=amd64 go build -o build/linux-amd64/monstache -ldflags="-s -w" monstache.go

